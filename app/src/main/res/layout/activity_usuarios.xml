<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/usuariosRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/brown_dark">
    <include layout="@layout/include_barra_admin" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:background="@color/cream">
        <TextView style="@style/Mesere.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Gestión de usuarios" />
        <TextView android:id="@+id/tvUsuariosActivos" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/burgundy"
            android:paddingTop="8dp" android:text="Meseros activos: 0" />
        <EditText android:id="@+id/etBuscarMesero" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:hint="Buscar mesero por nombre" android:inputType="textPersonName"
            android:singleLine="true" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipFiltroMeseros" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            app:singleSelection="true" app:selectionRequired="true" app:checkedChip="@id/chipTodos">
            <com.google.android.material.chip.Chip android:id="@+id/chipTodos"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Todos" android:checked="true" />
            <com.google.android.material.chip.Chip android:id="@+id/chipActivos"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Activos" />
            <com.google.android.material.chip.Chip android:id="@+id/chipInactivos"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Inactivos" />
        </com.google.android.material.chip.ChipGroup>
        <Button android:id="@+id/btnNuevoMesero" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="+ Nuevo mesero"
            android:textAllCaps="false" android:backgroundTint="@color/burgundy"
            android:textColor="@color/white" />
        <TextView android:id="@+id/tvUsuariosVacio" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:padding="18dp"
            android:text="No hay meseros que coincidan" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMeseros"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" android:paddingTop="8dp" />
    </LinearLayout>
</LinearLayout>
