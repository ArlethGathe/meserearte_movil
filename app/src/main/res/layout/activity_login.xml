<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado con degradado y logotipo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/bg_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_logo"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MesereArte"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de eventos para equipos de meseros"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Título -->
        <TextView
            style="@style/Mesere.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Iniciar sesión" />

        <TextView
            style="@style/Mesere.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selecciona tu rol para continuar" />

        <!-- Selección de rol -->
        <RadioGroup
            android:id="@+id/rgRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checkedButton="@id/rbAdministrador"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbAdministrador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/burgundy"
                android:text="Administrador" />

            <RadioButton
                android:id="@+id/rbMesero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:buttonTint="@color/burgundy"
                android:text="Mesero" />

        </RadioGroup>

        <!-- Correo electrónico -->
        <TextView
            style="@style/Mesere.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico" />

        <EditText
            android:id="@+id/etCorreo"
            style="@style/Mesere.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- Contraseña -->
        <TextView
            style="@style/Mesere.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/etContrasena"
            style="@style/Mesere.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Recordar sesión -->
        <CheckBox
            android:id="@+id/cbRecordar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/burgundy"
            android:text="Recordar mi sesión" />

        <!-- Botones de acceso -->
        <Button
            android:id="@+id/btnEntrarAdmin"
            style="@style/Mesere.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Entrar como administrador" />

        <Button
            android:id="@+id/btnEntrarMesero"
            style="@style/Mesere.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Entrar como mesero"
            android:visibility="gone" />

        <!-- Enlace de registro -->
        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="@color/burgundy"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
