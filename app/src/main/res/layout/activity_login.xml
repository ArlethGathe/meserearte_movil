<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/burgundy">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MesereArte"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de eventos para meseros"
                    android:textSize="13sp"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </FrameLayout>

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Iniciar sesión"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selecciona tu rol para continuar"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Selección de rol -->
        <RadioGroup
            android:id="@+id/rgRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:checkedButton="@id/rbAdministrador">

            <RadioButton
                android:id="@+id/rbAdministrador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrador"
                android:buttonTint="@color/burgundy" />

            <RadioButton
                android:id="@+id/rbMesero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Mesero"
                android:buttonTint="@color/burgundy" />

        </RadioGroup>

        <!-- Correo electrónico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Correo electrónico"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contraseña"
            android:textStyle="bold"
            android:textColor="@color/brown_dark" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Recordar sesión -->
        <CheckBox
            android:id="@+id/cbRecordar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Recordar mi sesión"
            android:buttonTint="@color/burgundy" />

        <!-- Botones de acceso -->
        <Button
            android:id="@+id/btnEntrarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Entrar como administrador"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/burgundy" />

        <Button
            android:id="@+id/btnEntrarMesero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Entrar como mesero"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/burgundy"
            android:visibility="gone" />

        <!-- Enlace de registro -->
        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="@color/burgundy"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
