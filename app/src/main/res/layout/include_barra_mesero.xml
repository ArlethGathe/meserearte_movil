<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Barra superior con menú de opciones -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMesero"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brown_dark"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:subtitleTextColor="@color/tan"
        app:title="MesereArte · Mesero"
        app:titleTextColor="@android:color/white" />

    <!-- Pestañas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream_card"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabInicio"
                style="@style/Mesere.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio" />

            <TextView
                android:id="@+id/tabMisEventos"
                style="@style/Mesere.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis eventos" />

            <TextView
                android:id="@+id/tabDisponibilidad"
                style="@style/Mesere.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disponibilidad" />

            <TextView
                android:id="@+id/tabNotificaciones"
                style="@style/Mesere.Tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notificaciones" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
