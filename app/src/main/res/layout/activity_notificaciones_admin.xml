<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificacionesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown_dark"
    android:orientation="vertical">

    <include layout="@layout/include_barra_admin" />

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cream"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Mesere.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notificaciones" />

            <TextView
                style="@style/Mesere.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Redacta y envía avisos al equipo de meseros" />

            <!-- Tipo de aviso -->
            <TextView
                style="@style/Mesere.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de aviso" />

            <Spinner
                android:id="@+id/spTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Evento relacionado -->
            <TextView
                style="@style/Mesere.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evento relacionado" />

            <Spinner
                android:id="@+id/spEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Título -->
            <TextView
                style="@style/Mesere.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título" />

            <EditText
                android:id="@+id/etTitulo"
                style="@style/Mesere.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Llegada 45 minutos antes"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <!-- Destinatarios -->
            <TextView
                style="@style/Mesere.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Destinatarios" />

            <TextView
                android:id="@+id/tvDestinatarios"
                style="@style/Mesere.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todos los meseros asignados" />

            <!-- Mensaje -->
            <TextView
                style="@style/Mesere.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mensaje" />

            <EditText
                android:id="@+id/etMensaje"
                style="@style/Mesere.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Escribe el aviso para el equipo"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />

            <Button
                android:id="@+id/btnEnviar"
                style="@style/Mesere.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Enviar notificación" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
