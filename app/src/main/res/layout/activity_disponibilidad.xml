<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/disponibilidadRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown_dark"
    android:orientation="vertical">

    <include layout="@layout/include_barra_mesero" />

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cream">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Mesere.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar disponibilidad" />

            <TextView
                android:id="@+id/tvBienvenidaMesero"
                style="@style/Mesere.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Indica si puedes asistir a cada evento" />

            <LinearLayout
                style="@style/Mesere.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Mesere.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boda Ramírez" />

                        <TextView
                            style="@style/Mesere.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="15 nov 2026 · 17:00 a 23:00 h" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstadoBoda"
                        style="@style/Mesere.Chip.Pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendiente" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDisponibleBoda"
                        style="@style/Mesere.Button.Tan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disponible" />

                    <Button
                        android:id="@+id/btnNoDisponibleBoda"
                        style="@style/Mesere.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="No disponible" />

                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/Mesere.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Mesere.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Evento Corporativo ABC" />

                        <TextView
                            style="@style/Mesere.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="22 nov 2026 · 08:00 a 14:00 h" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstadoCorp"
                        style="@style/Mesere.Chip.Pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendiente" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDisponibleCorp"
                        style="@style/Mesere.Button.Tan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disponible" />

                    <Button
                        android:id="@+id/btnNoDisponibleCorp"
                        style="@style/Mesere.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="No disponible" />

                </LinearLayout>
            </LinearLayout>

            <!-- Evento ya confirmado: sin botones -->
            <LinearLayout
                style="@style/Mesere.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Mesere.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Graduación ESCOM" />

                    <TextView
                        style="@style/Mesere.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="28 nov 2026 · 10:00 a 16:00 h" />
                </LinearLayout>

                <TextView
                    style="@style/Mesere.Chip.Confirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmada" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
