<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/asistenciasRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/brown_dark">
    <include layout="@layout/include_barra_mesero" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@color/cream">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/Mesere.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Registro de asistencias" />
            <TextView style="@style/Mesere.Subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Modo demostración de capitán" />
            <ProgressBar android:id="@+id/progresoAsistencias" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:layout_marginTop="16dp" android:max="4" />
            <TextView android:id="@+id/tvResumenAsistencias" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="10dp" android:text="0 de 4 registrados" />
            <LinearLayout android:id="@+id/contenedorAsistencias" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
