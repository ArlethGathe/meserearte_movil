<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inicioMeseroRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/brown_dark">
    <include layout="@layout/include_barra_mesero" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@color/cream">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/Mesere.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Inicio del mesero" />
            <TextView style="@style/Mesere.Subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Tu próximo servicio y confirmaciones" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <TextView style="@style/Mesere.CardTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Próxima asignación" />
                <TextView android:id="@+id/tvInicioProximo" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Boda Ramírez" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="@color/burgundy" />
                <TextView android:id="@+id/tvInicioFecha" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Fecha" />
                <TextView android:id="@+id/tvInicioLugar" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Lugar" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Disponibilidad pendiente" android:textColor="@color/warn_text" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="14dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <TextView style="@style/Mesere.CardTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Confirmaciones de disponibilidad" />
                <ProgressBar android:id="@+id/progresoConfirmaciones" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="12dp"
                    android:layout_marginTop="12dp" android:max="4" android:progress="2" />
                <TextView android:id="@+id/tvConfirmaciones" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="2 de 4 confirmaciones registradas" />
                <TextView android:id="@+id/tvConteoEventos" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="4 eventos asignados · 2 pendientes"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            <Button android:id="@+id/btnInicioDisponibilidad" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:backgroundTint="@color/burgundy" android:textColor="@color/white"
                android:textAllCaps="false" android:text="Confirmar disponibilidad" />
            <Button android:id="@+id/btnInicioEventos" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAllCaps="false"
                android:text="Ver mis eventos asignados" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
