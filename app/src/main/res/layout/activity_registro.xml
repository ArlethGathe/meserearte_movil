<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/registroRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="MesereArte"
            android:textColor="@color/burgundy"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Mesere.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Crear una cuenta" />

        <TextView
            style="@style/Mesere.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selecciona cómo deseas registrarte" />

        <!-- Selección de rol -->
        <RadioGroup
            android:id="@+id/rgRolRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checkedButton="@id/rbRegistroAdmin"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbRegistroAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/burgundy"
                android:text="Administrador: crear sala" />

            <RadioButton
                android:id="@+id/rbRegistroMesero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/burgundy"
                android:text="Mesero: tengo un código de sala" />

        </RadioGroup>

        <!-- Nombre y apellido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etNombre"
                style="@style/Mesere.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nombre"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etApellido"
                style="@style/Mesere.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="Apellido"
                android:inputType="textPersonName" />

        </LinearLayout>

        <!-- Correo -->
        <TextView
            style="@style/Mesere.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico" />

        <EditText
            android:id="@+id/etCorreoRegistro"
            style="@style/Mesere.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress" />

        <!-- Contraseña -->
        <TextView
            style="@style/Mesere.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/etContrasenaRegistro"
            style="@style/Mesere.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword" />

        <!-- Sala -->
        <TextView
            android:id="@+id/tvSalaEtiqueta"
            style="@style/Mesere.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la nueva sala" />

        <EditText
            android:id="@+id/etSala"
            style="@style/Mesere.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de tu sala"
            android:inputType="textCapWords" />

        <!-- Aviso de privacidad -->
        <CheckBox
            android:id="@+id/cbPrivacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:buttonTint="@color/burgundy"
            android:text="Acepto el aviso de privacidad" />

        <!-- Botón administrador -->
        <Button
            android:id="@+id/btnCrearSala"
            style="@style/Mesere.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Crear sala como admin" />

        <!-- Botón mesero -->
        <Button
            android:id="@+id/btnUnirme"
            style="@style/Mesere.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Unirme como mesero"
            android:visibility="gone" />

        <!-- Volver al inicio -->
        <TextView
            android:id="@+id/tvVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="@color/burgundy"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
