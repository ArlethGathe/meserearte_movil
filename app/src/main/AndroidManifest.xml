<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13 o superior: permiso para mostrar notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MesereArteApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MesereArte">

        <!-- Widgets: vistas nuevas -->
        <activity android:name=".UsuariosActivity" android:exported="false" />
        <activity android:name=".InicioMeseroActivity" android:exported="false" />
        <activity android:name=".AsistenciasActivity" android:exported="false" />

        <!-- Vista 10: Eventos asignados (mesero) -->
        <activity
            android:name=".EventosAsignadosActivity"
            android:exported="false" />

        <!-- Vista 11: Confirmar disponibilidad (mesero) -->
        <activity
            android:name=".DisponibilidadActivity"
            android:exported="false" />

        <!-- Vista 7: Notificaciones (administrador) -->
        <activity
            android:name=".NotificacionesAdminActivity"
            android:exported="false" />

        <!-- Vista 4: Gestión de eventos (administrador) -->
        <activity
            android:name=".EventosActivity"
            android:exported="false" />

        <!-- Vista 3: Panel principal (administrador) -->
        <activity
            android:name=".PanelAdminActivity"
            android:exported="false" />

        <!-- Vista 1: Registro de usuario -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false" />

        <!-- Vista 2: Inicio de sesión (pantalla principal) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget de pantalla principal del mesero -->
        <receiver
            android:name=".ProximoEventoWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/proximo_evento_widget_info" />
        </receiver>
    </application>

</manifest>
